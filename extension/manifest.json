{
  "manifest_version": 3,
  "name": "TikTok Studio Capture",
  "version": "1.0",
  "description": "One-click export of TikTok network data to a HAR file.",
  "permissions": ["debugger", "downloads", "activeTab"],
  "host_permissions": ["*://*.tiktok.com/*"],
  "action": {
    "default_title": "Capture TikTok Data"
  },
  "background": {
    "service_worker": "background.js"
  }
}
